# LLM Provider API Keys
# Choose one or more providers based on your needs
GOOGLE_API_KEY=your_google_genai_api_key_here  # For Gemini models
OPENAI_API_KEY=your_openai_api_key_here  # For OpenAI models and tracing
DASHSCOPE_API_KEY=your_dashscope_api_key_here  # For Qwen models

# LLM Model Configuration
LLM_MODEL_NAME=gpt-5-mini  # Default model name

# Google Custom Search API Configuration (for google_search preprocessor only)
SEARCH_API_KEY=your_google_search_api_key_here
SEARCH_ENGINE_ID=your_search_engine_id_here

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_CONSOLE=true  # Enable console output
LOG_TO_FILE=true  # Enable file logging
LOG_DIR=logs  # Directory for log files
LOG_INCLUDE_TRACE_ID=true  # Include OpenAI trace_id in logs
LOG_MAX_FILE_SIZE_MB=100  # Max size per log file before rotation
LOG_BACKUP_COUNT=10  # Number of backup log files to keep

# OpenAI Agents Tracing (for platform.openai.com/traces)
# Tracing is enabled by default. Set to 1 to disable.
# OPENAI_AGENTS_DISABLE_TRACING=0